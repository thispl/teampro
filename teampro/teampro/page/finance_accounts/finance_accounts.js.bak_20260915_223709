        refField: 'po_no', refLabel: 'PO / Ref', settleWord: 'received', settleColLabel: 'Received', searchPlaceholder: 'Customer, account, voucher, PO...',
        byTypeLabel: 'Party Type', partyTitle: 'Customers', partyPlural: 'parties', partyKpi: 'Customers Owing', partyCol: 'Parties',
        defaultPartyType: 'Customer', advLabel: 'Advances / Unallocated', advSub: 'customer advances / on-account (not netted above)',
        orderCfg: {
          doctype: 'Sales Order', slug: 'sales-order', party: 'customer', partyLabel: 'Customer', noun: 'sales orders',
          statuses: ['To Deliver and Bill', 'To Bill', 'To Deliver'], dateField: 'delivery_date', dateLabel: 'Delivery',
          fulfilField: 'per_delivered', fulfilLabel: 'Deliver',
          title: 'Pending Sales Orders', sub: 'Confirmed orders not yet fully billed/delivered \u2014 future receivables backlog'
        }
      },
      payable: {
        key: 'payables', reportName: 'Accounts Payable', title: 'Payables Outstanding',
