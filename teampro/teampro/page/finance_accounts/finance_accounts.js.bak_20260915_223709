      async function load() {
        buildShell();
        const listEl = $('.js-list'); if (listEl) listEl.innerHTML = '<div class="pd-loading"><div class="spinner"></div><div class="js-prog">Loading ' + cfg.reportName + '...</div></div>';
        const ordEl = $('.js-orders'); if (ordEl && !listEl) ordEl.innerHTML = '<div class="pd-loading"><div class="spinner"></div><div class="js-prog">Loading ' + (cfg.orderCfg ? cfg.orderCfg.title : '') + '...</div></div>';
        const unrecEl = $('.js-unrec'); if (unrecEl && !listEl) unrecEl.innerHTML = '<div class="pd-loading"><div class="spinner"></div><div class="js-prog">Loading unreconciled payments...</div></div>';
        try {
          // Section-specific fast paths: skip loading full AR/AP report
          if (_section === 'orders') {
            const companies = await getCompanies();
            const comps = new Set(companies.map(c => c.name));
            try { state.orders = await fetchOrders(cfg.orderCfg); }
            catch (e) { console.warn('[' + cfg.key + '] orders failed', e); state.orders = []; }
            const fill = (sel, vals) => { const el = $(sel); if (el) Array.from(vals).sort().forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; el.appendChild(o); }); };
            fill('.js-company', comps); fill('.js-cur', new Set(['INR']));
            render();
            return;
          }
          if (_section === 'unreconciled') {
            const companies = await getCompanies();
            await getEmployees();
            const comps = new Set(companies.map(c => c.name));
            try { state.unreconciled = await fetchUnreconciledPayments(cfg.key); }
            catch (e) { console.warn('[' + cfg.key + '] unreconciled failed', e); state.unreconciled = []; }
            const curs = new Set(), types = new Set();
            state.unreconciled.forEach(u => { if (u.currency) curs.add(u.currency); if (u.company) comps.add(u.company); if (u.party_type) types.add(u.party_type); });
            state.baseCur = curs.size ? Array.from(curs).sort()[0] : 'INR';
            const fill = (sel, vals) => { const el = $(sel); if (el) Array.from(vals).sort().forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; el.appendChild(o); }); };
            fill('.js-cur', curs); fill('.js-type', types); fill('.js-company', comps);
            render();
            return;
          }
          const companies = await getCompanies();
          // Load employees and all company reports in parallel for faster loading
          const prog = $('.js-prog');
          if (prog) prog.textContent = 'Loading ' + cfg.reportName + '... (fetching ' + companies.length + ' companies in parallel)';
          const [empResult, ...reportResults] = await Promise.all([
            getEmployees().catch(e => { console.warn('[' + cfg.key + '] employees failed', e); }),
            ...companies.map(c => xcall('frappe.desk.query_report.run', { report_name: cfg.reportName, filters: { company: c.name, report_date: REPORT_DATE, ageing_based_on: 'Due Date', range1: 30, range2: 60, range3: 90, range4: 120 }, ignore_prepared_report: 1 }).then(res => ({ company: c, rows: (res && res.result) || [] })).catch(e => { console.warn('[' + cfg.key + '] failed for', c.name, e); return { company: c, rows: [] }; }))
          ]);
          const all = [];
          reportResults.forEach(r => {
            if (r && r.rows) r.rows.forEach(row => { if (row && typeof row === 'object' && (row.voucher_no || row.outstanding)) { row.__company = r.company.name; all.push(row); } });
          });
          if (prog) prog.textContent = 'Processing ' + cfg.reportName + '...';
          const norm = r => ({
            company: r.__company, currency: r.currency || r.account_currency || 'INR',
            party_type: r.party_type || cfg.defaultPartyType, party: r.party || '(No Party)', party_account: r.party_account || '',
            voucher_type: r.voucher_type || '', voucher_no: r.voucher_no || '', ref: r[cfg.refField] || '',
            posting_date: r.posting_date || '', due_date: r.due_date || '',
            invoiced: Number(r.invoiced) || 0, paid: Number(r.paid) || 0, credit_note: Number(r.credit_note) || 0,
            outstanding: Number(r.outstanding) || 0, age: (r.age == null || r.age === '') ? null : Number(r.age),
            account_manager: ''
          });
          let normed = all.map(norm).filter(r => r.voucher_no);
          // Filter out cancelled documents (docstatus=2) that have residual GL/PLE balances in AP/AR report
          const _byType = {};
          normed.forEach(r => { if (r.voucher_type && r.voucher_no) { if (!_byType[r.voucher_type]) _byType[r.voucher_type] = new Set(); _byType[r.voucher_type].add(r.voucher_no); } });
          const _cancelledSet = new Set();
          const _dtMap = { 'Sales Invoice':'Sales Invoice','Purchase Invoice':'Purchase Invoice','Payment Entry':'Payment Entry','Journal Entry':'Journal Entry','Expense Claim':'Expense Claim','Employee Advance':'Employee Advance' };
          await Promise.all(Object.keys(_byType).map(async vt => {
            const dt = _dtMap[vt]; if (!dt) return;
            try { const cl = await xcall('frappe.client.get_list', { doctype: dt, fields: ['name'], filters: [['docstatus','=',2],['name','in',Array.from(_byType[vt])]], limit_page_length: 0 }); (cl||[]).forEach(c => _cancelledSet.add(c.name)); } catch(e) {}
          }));
          if (_cancelledSet.size) normed = normed.filter(r => !_cancelledSet.has(r.voucher_no));
          state.rows = normed.filter(r => r.outstanding > 0.009);
          state.advances = normed.filter(r => r.outstanding < -0.009);
          const curs = new Set(), types = new Set(), comps = new Set();
          state.rows.forEach(d => { curs.add(d.currency); types.add(d.party_type); if (d.company) comps.add(d.company); });
          state.baseCur = curs.size ? Array.from(curs).sort()[0] : 'INR';
          const fill = (sel, vals) => { const el = $(sel); Array.from(vals).sort().forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; el.appendChild(o); }); };
          fill('.js-cur', curs); fill('.js-type', types); fill('.js-company', comps);
          // Fetch account_manager for receivables customers
          if (cfg.key === 'receivables' && state.rows.length) {
            try {
              const custNames = Array.from(new Set(state.rows.filter(r => r.party_type === 'Customer').map(r => r.party))).filter(n => n && n !== '(No Party)');
              if (custNames.length) {
                const custRows = await xcall('frappe.client.get_list', { doctype: 'Customer', fields: ['name', 'account_manager'], filters: [['name', 'in', custNames]], limit_page_length: 0 });
                const amMap = {}; (custRows || []).forEach(c => { amMap[c.name] = c.account_manager || ''; });
                state.rows.forEach(r => { if (r.party_type === 'Customer') r.account_manager = amMap[r.party] || ''; });
              }
            } catch (e) { console.warn('[receivables] account_manager fetch failed', e); }
          }
          // Full load: orders and unreconciled are now separate sub-tabs, skip them here
          // Only fetch employee payables for payables full view
          const needOrders = false;
          const needUnrec = false;
          const needEmpPay = (cfg.key === 'payables') && (!_partyFilter || _partyFilter === 'Employee');
          const [ordersResult, unrecResult, empPayResult] = await Promise.all([
            needOrders ? fetchOrders(cfg.orderCfg).catch(e => { console.warn('[' + cfg.key + '] orders failed', e); return []; }) : Promise.resolve([]),
            needUnrec ? fetchUnreconciledPayments(cfg.key).catch(e => { console.warn('[' + cfg.key + '] unreconciled failed', e); return []; }) : Promise.resolve([]),
            needEmpPay ? fetchEmployeePayables().catch(e => { console.warn('[' + cfg.key + '] employee payables failed', e); return []; }) : Promise.resolve(null)
          ]);
          state.orders = ordersResult;
          state.unreconciled = unrecResult;
          state.orders.forEach(o => { if (o.company) comps.add(o.company); });
          state.unreconciled.forEach(u => { if (u.currency) curs.add(u.currency); if (u.company) comps.add(u.company); });
          if (empPayResult && cfg.key === 'payables') {
            const existingNos = new Set(state.rows.map(r => r.voucher_no));
            empPayResult.forEach(r => {
              if (r.voucher_no && existingNos.has(r.voucher_no)) return;
              state.rows.push(r);
              if (r.currency) curs.add(r.currency);
              if (r.company) comps.add(r.company);
              types.add(r.party_type);
            });
          }
          if (!state.rows.length) { $('.js-list').innerHTML = '<div class="pd-empty">No outstanding ' + cfg.key + ' found.</div>'; render(); return; }
          render();
        } catch (e) { console.error('[' + cfg.key + ']', e); $('.js-list').innerHTML = '<div class="pd-err">\u26A0 ' + esc(e && e.message || String(e)) + '</div>'; }
      }
      async function fetchOrders(oc) {
        const fields = ['name', 'status', 'company', 'currency', 'transaction_date', oc.dateField, 'grand_total', 'base_grand_total', 'per_billed', oc.fulfilField, oc.party];
        // Add account_manager for Sales Order
        if (oc.doctype === 'Sales Order') fields.push('account_manager');
        const rows = await xcall('frappe.client.get_list', {
          doctype: oc.doctype,
          fields: fields,
          filters: { docstatus: 1, status: ['in', oc.statuses] },
          order_by: 'transaction_date desc', limit_page_length: 0
        });
        return (rows || []).map(r => {
          const val = Number(r.base_grand_total) || 0, pb = Number(r.per_billed) || 0, pf = Number(r[oc.fulfilField]) || 0;
          return {
            no: r.name, status: r.status, company: r.company, currency: r.currency || 'INR',
            date: r.transaction_date || '', expected: r[oc.dateField] || '', party: r[oc.party] || '(none)',
            value: val, perBilled: pb, perFulfil: pf,
            pendingBill: val * (1 - pb / 100), pendingFulfil: val * (1 - pf / 100),
            account_manager: r.account_manager || ''
          };
        });
      }
      return { load: load, getState: () => state, getRows: () => state.rows.filter(docPasses), getOrders: () => state.orders, getUnreconciled: () => state.unreconciled, getAdvances: () => state.advances, cfg: cfg };
    }

