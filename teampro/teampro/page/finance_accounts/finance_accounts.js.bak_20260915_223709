    if (!document.getElementById('pd-style-block')) {
        const styleEl = document.createElement('style');
        styleEl.id = 'pd-style-block';
        styleEl.textContent = `#pd-root {
  --pd-bg: #f0f2f5;
  --pd-card: #ffffff;
  --pd-border: #e3e8ef;
  --pd-border-light: #f0f2f5;
  --pd-text: #1e293b;
  --pd-text-secondary: #475569;
  --pd-muted: #94a3b8;
  --pd-primary: #2563eb;
  --pd-primary-dark: #1d4ed8;
  --pd-primary-light: #eff6ff;
  --pd-danger: #dc2626;
  --pd-danger-light: #fef2f2;
  --pd-danger-bg: #fee2e2;
  --pd-warn: #f59e0b;
  --pd-warn-light: #fffbeb;
  --pd-ok: #059669;
  --pd-ok-light: #ecfdf5;
  --pd-purple: #7c3aed;
  --pd-purple-light: #f5f3ff;
  --pd-shadow-xs: 0 1px 2px rgba(0,0,0,.04);
  --pd-shadow-sm: 0 1px 3px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.03);
  --pd-shadow-md: 0 4px 6px -1px rgba(0,0,0,.05), 0 2px 4px -2px rgba(0,0,0,.03);
  --pd-shadow-lg: 0 10px 25px -3px rgba(0,0,0,.08), 0 4px 10px -4px rgba(0,0,0,.04);
  --pd-radius: 12px;
  --pd-radius-sm: 8px;
  --pd-radius-xs: 6px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: var(--pd-text);
  padding: 16px;
}

#pd-root * { box-sizing: border-box; }

#pd-root .pd-wrap {
  max-width: 1400px;
  margin: 0 auto;
  color: var(--pd-text);
}

/* ===== HEADER ===== */
#pd-root .pd-header {
  background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 60%, #3b82f6 100%);
