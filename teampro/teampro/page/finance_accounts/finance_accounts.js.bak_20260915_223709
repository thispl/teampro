                   'advance_amount', 'paid_amount', 'claimed_amount', 'return_amount', 'status', 'advance_account'],
          filters: [['docstatus', '=', 1], ['status', 'in', ['Paid', 'Partly Claimed and Returned']]],
          order_by: 'posting_date desc', limit_page_length: 0
        }).catch(e => { console.warn('[emp-advance] failed', e); return []; }),
        xcall('frappe.client.get_list', {
          doctype: 'Expense Claim',
          fields: ['name', 'employee', 'employee_name', 'posting_date', 'company', 'currency',
                   'total_sanctioned_amount', 'total_advance_amount', 'grand_total', 'total_claimed_amount',
                   'total_amount_reimbursed', 'status', 'payable_account'],
          filters: [['docstatus', '=', 1], ['status', '=', 'Unpaid']],
          order_by: 'posting_date desc', limit_page_length: 0
        }).catch(e => { console.warn('[expense-claim] failed', e); return []; })
      ]);

      const empAdv = (advRows || []).map(r => {
        const outstanding = (Number(r.paid_amount) || 0) - (Number(r.claimed_amount) || 0) - (Number(r.return_amount) || 0);
        return {
          company: r.company || '', currency: r.currency || 'INR',
          party_type: 'Employee', party: r.employee || '(No Employee)', party_account: r.advance_account || '',
          voucher_type: 'Employee Advance', voucher_no: r.name || '',
          ref: r.purpose || '', posting_date: r.posting_date || '', due_date: r.posting_date || '',
          invoiced: Number(r.paid_amount) || 0, paid: (Number(r.claimed_amount) || 0) + (Number(r.return_amount) || 0),
          credit_note: 0, outstanding: outstanding, age: null, __empAdv: true
        };
      }).filter(r => r.outstanding > 0.009);

      const expClaim = (ecRows || []).map(r => {
        const outstanding = (Number(r.total_claimed_amount) || 0) - (Number(r.total_amount_reimbursed) || 0);
        return {
          company: r.company || '', currency: r.currency || 'INR',
          party_type: 'Employee', party: r.employee || '(No Employee)', party_account: r.payable_account || '',
          voucher_type: 'Expense Claim', voucher_no: r.name || '',
          ref: '', posting_date: r.posting_date || '', due_date: r.posting_date || '',
          invoiced: Number(r.grand_total) || 0, paid: Number(r.total_amount_reimbursed) || 0,
          credit_note: 0, outstanding: outstanding, age: null, __empClaim: true
        };
      }).filter(r => r.outstanding > 0.009);

      return [...empAdv, ...expClaim];
    }

    // ---------- dashboard factory ----------
    function Dashboard(mount, cfg) {
      const state = { rows: [], advances: [], orders: [], orderPage: 0, baseCur: 'INR', filterCur: '', filterType: '', filterCompany: '', filterBucket: '', search: '', overdueOnly: false, unreconciled: [] };
      const $ = sel => mount.querySelector(sel);

      function docPasses(d) {
        if (_partyFilter && d.party_type !== _partyFilter) return false;
        if (state.filterCur && d.currency !== state.filterCur) return false;
        if (state.filterType && d.party_type !== state.filterType) return false;
        if (state.filterCompany && d.company !== state.filterCompany) return false;
        if (state.filterBucket && bucketOf(d.age) !== state.filterBucket) return false;
        if (state.overdueOnly && !isOverdue(d.age)) return false;
        if (state.search) {
          const q = state.search.toLowerCase();
          if (!((d.party || '').toLowerCase().includes(q) || (d.voucher_no || '').toLowerCase().includes(q) ||
                (d.ref || '').toLowerCase().includes(q) || (d.party_account || '').toLowerCase().includes(q) ||
                partyDisp(d.party_type, d.party).toLowerCase().includes(q))) return false;
        }
        return true;
      }
      function sumBy(docs, keyFn) {
        const m = {};
        docs.forEach(d => { const k = keyFn(d); if (!m[k]) m[k] = { amt: 0, docs: 0, parties: {} }; m[k].amt += d.outstanding; m[k].docs++; m[k].parties[d.party_type + '||' + d.party] = 1; });
        Object.keys(m).forEach(k => m[k].partyCount = Object.keys(m[k].parties).length);
        return m;
      }
      function barRows(arr, labelFn, subFn) {
        const max = Math.max.apply(null, arr.map(x => x.amt).concat([1]));
        return arr.map(x => '<div class="pd-bar-row"><div class="bl" title="' + esc(x.k) + '">' + esc(labelFn(x.k)) + '</div>' +
          '<div class="bt"><div class="bf" style="width:' + Math.max(2, pct(x.amt, max)) + '%"><span class="bf-label">' + fmtCompact(x.amt) + '</span></div></div>' +
          '<div class="bv">' + subFn(x) + '</div></div>').join('') || '<div class="pd-empty">No data.</div>';
      }
      function docRows(docs) {
        if (!docs.length) return '<div class="pd-empty-inner">No vouchers match the current filters.</div>';
        docs.sort((a, b) => (b.age == null ? -1 : b.age) - (a.age == null ? -1 : a.age));
        const totalOut = docs.reduce((s, d) => s + d.outstanding, 0), cur = docs[0].currency;
        return '<table class="pd-doc-table"><thead><tr><th>#</th><th>Type</th><th>Voucher</th><th>' + cfg.refLabel + '</th><th>Due</th><th>Age</th><th class="amt">Invoiced</th><th class="amt">' + cfg.settleColLabel + '</th><th class="amt">Outstanding</th></tr></thead><tbody>' +
          docs.map((d, i) => { const b = bucketOf(d.age);
            return '<tr class="' + (isOverdue(d.age) ? 'overdue' : '') + '"><td class="pd-idx">' + (i + 1) + '</td>' +
              '<td><span class="pd-vtype ' + vtypeClass(d.voucher_type) + '">' + esc(d.voucher_type) + '</span></td>' +
              '<td><a class="vlink" target="_blank" href="' + vlink(d.voucher_type, d.voucher_no) + '">' + esc(d.voucher_no) + '</a></td>' +
              '<td class="pd-date">' + esc(d.ref || '\u2014') + '</td><td class="pd-date">' + esc(d.due_date || '\u2014') + '</td>' +
              '<td><span class="age-chip" style="background:' + BMETA[b].color + '1a;color:' + BMETA[b].color + '">' + (d.age == null ? '\u2014' : (d.age < 0 ? (-d.age) + 'd left' : d.age + 'd')) + '</span></td>' +
              '<td class="amt">' + fmt(d.invoiced, d.currency) + '</td><td class="amt credit">' + fmt(d.paid + d.credit_note, d.currency) + '</td>' +
              '<td class="amt outstanding">' + fmt(d.outstanding, d.currency) + '</td></tr>';
          }).join('') +
          '</tbody><tfoot><tr><td colspan="8" class="tfoot-lbl">Total Outstanding</td><td class="amt outstanding tfoot-amt">' + fmt(totalOut, cur) + '</td></tr></tfoot></table>';
      }
      function curTotal(curMap) {
        const keys = Object.keys(curMap).filter(c => Math.abs(curMap[c]) > 0.009).sort();
        if (state.filterCur && curMap[state.filterCur] !== undefined) return fmt(curMap[state.filterCur], state.filterCur);
        if (!keys.length) return fmt(0, state.baseCur);
        return keys.map(c => fmtCompact(curMap[c])).join(' + ');
      }

      function render() {
        // For section-specific shells, only render the relevant section
        if (_section === 'orders') { renderOrders(); return; }
        if (_section === 'unreconciled') { renderUnreconciled(); return; }
        const docs = state.rows.filter(docPasses);
        const curMap = {}; docs.forEach(d => curMap[d.currency] = (curMap[d.currency] || 0) + d.outstanding);
        const grand = docs.reduce((s, d) => s + d.outstanding, 0), cur = state.filterCur || state.baseCur;
        const partySet = {}; docs.forEach(d => partySet[d.party_type + '||' + d.party] = 1);
        const totalParties = Object.keys(partySet).length;
        const overdueAmt = docs.filter(d => isOverdue(d.age)).reduce((s, d) => s + d.outstanding, 0);
        const overdueDocs = docs.filter(d => isOverdue(d.age)).length;
        const notDueAmt = docs.filter(d => bucketOf(d.age) === 'notdue').reduce((s, d) => s + d.outstanding, 0);
        const critAmt = docs.filter(d => ['b4', 'b5'].indexOf(bucketOf(d.age)) !== -1).reduce((s, d) => s + d.outstanding, 0);
        const advTotal = state.advances.filter(a => (!state.filterCompany || a.company === state.filterCompany) && (!state.filterType || a.party_type === state.filterType) && (!state.filterCur || a.currency === state.filterCur)).reduce((s, a) => s + a.outstanding, 0);

        // Company-wise breakdown for KPI sub-labels
        const compMap2 = {}; docs.forEach(d => { const c = d.company || '\u2014'; compMap2[c] = (compMap2[c] || 0) + d.outstanding; });
        const compList = Object.keys(compMap2).sort((a, b) => compMap2[b] - compMap2[a]).slice(0, 3);
        const compLabel = compList.map(c => companyAbbr(c) + ': ' + fmtCompact(compMap2[c])).join(' \u00B7 ');
        // Company-wise overdue
        const compOverdue = {}; docs.filter(d => isOverdue(d.age)).forEach(d => { const c = d.company || '\u2014'; compOverdue[c] = (compOverdue[c] || 0) + d.outstanding; });
        const compOverdueList = Object.keys(compOverdue).sort((a, b) => compOverdue[b] - compOverdue[a]).slice(0, 3);
        const compOverdueLabel = compOverdueList.map(c => companyAbbr(c) + ': ' + fmtCompact(compOverdue[c])).join(' \u00B7 ');
        // Company-wise party count
        const compPartyMap = {}; docs.forEach(d => { const c = d.company || '\u2014'; if (!compPartyMap[c]) compPartyMap[c] = {}; compPartyMap[c][d.party_type + '||' + d.party] = 1; });
        const compPartyLabel = Object.keys(compPartyMap).sort((a, b) => Object.keys(compPartyMap[b]).length - Object.keys(compPartyMap[a]).length).slice(0, 3).map(c => companyAbbr(c) + ': ' + Object.keys(compPartyMap[c]).length).join(' \u00B7 ');

        const cards = [
          { lbl: 'Total Outstanding', val: curTotal(curMap), full: fmt(grand, cur), cls: 'danger', sub: fmtNum(docs.length) + ' vouchers \u00B7 ' + fmtNum(totalParties) + ' ' + cfg.partyPlural + (compLabel ? '<div class="card-comp">' + compLabel + '</div>' : ''),
            svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>' },
          { lbl: 'Overdue', val: fmtCompact(overdueAmt), full: fmt(overdueAmt, cur), cls: 'orange', sub: fmtPct(overdueAmt, grand) + ' of total \u00B7 ' + fmtNum(overdueDocs) + ' vouchers' + (compOverdueLabel ? '<div class="card-comp">' + compOverdueLabel + '</div>' : ''),
            svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>' },
          { lbl: cfg.partyKpi, val: fmtNum(totalParties), cls: 'blue', sub: 'with outstanding balance' + (compPartyLabel ? '<div class="card-comp">' + compPartyLabel + '</div>' : ''),
            svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75M9 11a4 4 0 100-8 4 4 0 000 8z"/></svg>' },
          { lbl: cfg.advLabel, val: fmtCompact(Math.abs(advTotal)), full: fmt(Math.abs(advTotal), cur), cls: 'gray', sub: cfg.advSub,
            svg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 4h22v16H1z"/><path d="M1 10h22"/></svg>' }
        ];
        $('.js-stats').innerHTML = cards.map(c => '<div class="pd-stat ' + c.cls + '"><div class="stat-icon">' + c.svg + '</div><div class="stat-body"><div class="lbl">' + c.lbl + '</div><div class="val ' + c.cls + '"' + (c.full ? ' title="' + c.full + '"' : '') + '>' + c.val + '</div><div class="sub">' + c.sub + '</div></div></div>').join('');

        const ageMap = sumBy(docs, d => bucketOf(d.age));
        const segs = BUCKETS.filter(b => (ageMap[b.key] || {}).amt > 0.009);
        const stackBar = '<div class="stack-bar">' + segs.map(b => { const a = ageMap[b.key].amt; return '<div class="stack-seg" title="' + b.label + ': ' + fmt(a, cur) + '" style="width:' + pct(a, grand) + '%;background:' + b.color + '"></div>'; }).join('') + '</div>';
        const ageRows = BUCKETS.map(b => { const m = ageMap[b.key] || { amt: 0, docs: 0, partyCount: 0 };
          return '<tr class="age-row' + (state.filterBucket === b.key ? ' active' : '') + '" data-bucket="' + b.key + '"><td><span class="dot" style="background:' + b.color + '"></span>' + b.label + '</td><td class="amt">' + fmt(m.amt, cur) + '</td><td class="amt pctcol">' + fmtPct(m.amt, grand) + '</td><td class="amt">' + fmtNum(m.docs) + '</td><td class="amt">' + fmtNum(m.partyCount) + '</td></tr>';
        }).join('');
        $('.js-ageing').innerHTML = stackBar + '<table class="pd-mini-table"><thead><tr><th>Ageing Bucket</th><th class="amt">Outstanding</th><th class="amt">%</th><th class="amt">Vouchers</th><th class="amt">' + cfg.partyCol + '</th></tr></thead><tbody>' + ageRows + '</tbody><tfoot><tr><td class="tfoot-lbl">Total</td><td class="amt tfoot-amt">' + fmt(grand, cur) + '</td><td class="amt">100%</td><td class="amt">' + fmtNum(docs.length) + '</td><td class="amt">' + fmtNum(totalParties) + '</td></tr></tfoot></table><div class="age-hint">Click a bucket row to filter the breakdown below. Ageing is based on due date.</div>';

        const typeMap = sumBy(docs, d => d.party_type);
        $('.js-bytype').innerHTML = barRows(Object.keys(typeMap).map(k => ({ k: k, ...typeMap[k] })).sort((a, b) => b.amt - a.amt), k => k, m => fmtNum(m.partyCount) + ' ' + cfg.partyPlural);
        const compMap = sumBy(docs, d => d.company || '\u2014');
        $('.js-bycompany').innerHTML = barRows(Object.keys(compMap).map(k => ({ k: k, ...compMap[k] })).sort((a, b) => b.amt - a.amt), k => companyShort(k), m => fmtNum(m.docs) + ' docs');

        const byType = {};
        docs.forEach(d => { const t = d.party_type; if (!byType[t]) byType[t] = {}; if (!byType[t][d.party]) byType[t][d.party] = []; byType[t][d.party].push(d); });
        const typesSorted = Object.keys(byType).sort((a, b) => (typeMap[b] ? typeMap[b].amt : 0) - (typeMap[a] ? typeMap[a].amt : 0));
        function renderTypeGroup(t) {
          const parties = Object.keys(byType[t]).map(pk => ({ party: pk, docs: byType[t][pk], amt: byType[t][pk].reduce((s, d) => s + d.outstanding, 0) })).sort((a, b) => b.amt - a.amt);
          const rows = parties.map((p, pi) => {
            const accs = Array.from(new Set(p.docs.map(d => d.party_account))).join(', ');
            return '<div class="pd-party"><div class="pd-party-row" data-toggle="1"><span class="caret">\u25B6</span><span class="pidx">' + (pi + 1) + '</span><span class="pname">' + esc(partyDisp(t, p.party)) + '</span><span class="pacc" title="' + esc(accs) + '">' + esc(accs) + '</span><span class="pamt">' + fmt(p.amt, p.docs[0].currency) + '</span><span class="pcnt">' + p.docs.length + ' doc' + (p.docs.length !== 1 ? 's' : '') + '</span></div><div class="pd-docs" style="display:none">' + docRows(p.docs.slice()) + '</div></div>';
          }).join('');
          return '<div class="pd-group"><div class="pd-group-head"><div class="gt">' + esc(t) + ' <span class="pill">' + parties.length + '</span></div><div class="gtot">' + fmt(typeMap[t].amt, cur) + ' \u00B7 ' + parties.length + ' ' + cfg.partyPlural + ' \u00B7 ' + typeMap[t].docs + ' docs</div></div>' + rows + '</div>';
        }
        // For payables: show Supplier and Employee side-by-side; others stacked
        // (skip side-by-side when _partyFilter is set — already filtered to one type)
        if (cfg.key === 'payables' && !_partyFilter) {
          const sideTypes = ['Supplier', 'Employee'].filter(t => byType[t]);
          const otherTypes = typesSorted.filter(t => sideTypes.indexOf(t) === -1);
          let html = '';
          if (sideTypes.length >= 2) {
            html += '<div class="pd-side-tables"><div class="pd-side-col"><h3 style="margin:0 0 10px;font-size:14px;color:#0F1568;border-bottom:2px solid #0F1568;padding-bottom:6px;">Supplier</h3>' + renderTypeGroup('Supplier') + '</div><div class="pd-side-col"><h3 style="margin:0 0 10px;font-size:14px;color:#0F1568;border-bottom:2px solid #0F1568;padding-bottom:6px;">Employee</h3>' + renderTypeGroup('Employee') + '</div></div>';
          } else if (sideTypes.length === 1) {
            html += renderTypeGroup(sideTypes[0]);
          }
          html += otherTypes.map(t => renderTypeGroup(t)).join('');
          $('.js-list').innerHTML = html || '<div class="pd-empty">No outstanding ' + cfg.key + ' match the current filters.</div>';
        } else {
          $('.js-list').innerHTML = typesSorted.map(t => renderTypeGroup(t)).join('') || '<div class="pd-empty">No outstanding ' + cfg.key + ' match the current filters.</div>';
        }

        $('.js-count').textContent = fmtNum(totalParties) + ' ' + cfg.partyPlural + ' \u00B7 ' + fmtCompact(grand);
        if ($('.js-orders-panel')) renderOrders();
        if ($('.js-unrec-panel')) renderUnreconciled();
      }

      function renderUnreconciled() {
        // Compute age (days since posting date) for ageing/overdue filters
        const daysBetween = (d) => {
          if (!d) return null;
          const ms = (new Date(REPORT_DATE) - new Date(d)) / 86400000;
          return isNaN(ms) ? null : Math.round(ms);
        };
        const unrec = state.unreconciled.map(u => ({ ...u, age: daysBetween(u.posting_date) }));
        const unrecNames = new Set(unrec.map(u => u.name));
        const advRows = state.advances.filter(a => !unrecNames.has(a.voucher_no)).map(a => ({
          source: 'advance', name: a.voucher_no, payment_type: '', voucher_type: a.voucher_type,
          party_type: a.party_type, party: a.party, party_name: '',
          posting_date: a.posting_date, company: a.company,
          paid_amount: Math.abs(a.outstanding), unallocated: Math.abs(a.outstanding),
          currency: a.currency, account: a.party_account, age: daysBetween(a.posting_date)
        }));
        let all = [...unrec, ...advRows];
        // Apply ALL filters: company, currency, party type, ageing bucket, overdue-only, search
        all = all.filter(u => {
          if (state.filterCompany && u.company !== state.filterCompany) return false;
          if (state.filterCur && u.currency !== state.filterCur) return false;
          if (state.filterType && u.party_type !== state.filterType) return false;
          if (state.filterBucket && bucketOf(u.age) !== state.filterBucket) return false;
          if (state.overdueOnly && !isOverdue(u.age)) return false;
          if (state.search) {
            const q = state.search.toLowerCase();
            const pl = (u.party_name || partyDisp(u.party_type, u.party) || u.party || '').toLowerCase();
            if (!(pl.includes(q) || (u.name || '').toLowerCase().includes(q) ||
                  (u.account || '').toLowerCase().includes(q) || (u.party_type || '').toLowerCase().includes(q))) return false;
          }
          return true;
        });
        const wrap = $('.js-unrec');
        if (!wrap) return;
        if (!all.length) { wrap.innerHTML = '<div class="pd-empty-inner">No unreconciled payments or on-account advances for the current filters.</div>'; return; }
        const totalUnalloc = all.reduce((s, u) => s + u.unallocated, 0);
        const cur = state.filterCur || all[0].currency || state.baseCur;
        all.sort((a, b) => (b.age == null ? -1 : b.age) - (a.age == null ? -1 : a.age));
        const body = all.map((u, i) => {
          const pl = u.party_name || partyDisp(u.party_type, u.party) || u.party || '\u2014';
          const b = bucketOf(u.age);
          const srcBadge = u.source === 'payment'
            ? '<span class="unrec-src payment">Payment Entry</span>'
            : '<span class="unrec-src advance">On-Account Advance</span>';
          const peLink = u.source === 'payment'
            ? '<a class="vlink" target="_blank" href="/app/payment-entry/' + encodeURIComponent(u.name) + '">' + esc(u.name) + '</a>'
            : '<a class="vlink" target="_blank" href="' + vlink(u.voucher_type || '', u.name) + '">' + esc(u.name) + '</a>';
          const ageChip = u.age == null ? '\u2014' : '<span class="age-chip" style="background:' + BMETA[b].color + '1a;color:' + BMETA[b].color + '">' + (u.age < 0 ? (-u.age) + 'd left' : u.age + 'd') + '</span>';
          return '<tr class="' + (isOverdue(u.age) ? 'overdue' : '') + '"><td class="pd-idx">' + (i + 1) + '</td>' +
            '<td>' + srcBadge + '</td>' +
            '<td>' + peLink + '</td>' +
            '<td>' + esc(pl) + '</td>' +
            '<td>' + esc(u.party_type || '\u2014') + '</td>' +
            '<td class="pd-date">' + esc(u.posting_date || '\u2014') + '</td>' +
            '<td>' + ageChip + '</td>' +
            '<td>' + esc(u.account || '\u2014') + '</td>' +
            '<td class="amt">' + fmt(u.paid_amount, u.currency) + '</td>' +
            '<td class="amt outstanding">' + fmt(u.unallocated, u.currency) + '</td></tr>';
        }).join('');
        wrap.innerHTML = '<div class="unrec-summary"><div class="unrec-kpi"><div class="k-l">Unreconciled Items</div><div class="k-v">' + fmtNum(all.length) + '</div><div class="k-s">payments + advances</div></div>' +
          '<div class="unrec-kpi"><div class="k-l">Total Unallocated</div><div class="k-v">' + fmtCompact(totalUnalloc) + '</div><div class="k-s">' + fmt(totalUnalloc, cur) + '</div></div></div>' +
          '<table class="pd-doc-table"><thead><tr><th>#</th><th>Source</th><th>Voucher</th><th>Party</th><th>Party Type</th><th>Date</th><th>Age</th><th>Account</th><th class="amt">Paid Amount</th><th class="amt">Unallocated</th></tr></thead><tbody>' + body +
          '</tbody><tfoot><tr><td colspan="9" class="tfoot-lbl">Total Unallocated</td><td class="amt outstanding tfoot-amt">' + fmt(totalUnalloc, cur) + '</td></tr></tfoot></table>';
      }

      function renderOrders() {
        const oc = cfg.orderCfg; if (!oc) return;
        let ords = state.orders.filter(o => (!state.filterCompany || o.company === state.filterCompany) && (!state.filterCur || o.currency === state.filterCur));
        if (state.search) { const q = state.search.toLowerCase(); ords = ords.filter(o => (o.party || '').toLowerCase().includes(q) || (o.no || '').toLowerCase().includes(q)); }
        const cnt = ords.length;
        const totVal = ords.reduce((s, o) => s + o.value, 0);
        const pendBill = ords.reduce((s, o) => s + o.pendingBill, 0);
        const pendFul = ords.reduce((s, o) => s + o.pendingFulfil, 0);
        const cards = [
          ['Open Orders', fmtNum(cnt), 'awaiting completion'],
          ['Order Value', fmtCompact(totVal), 'total (base currency)'],
          ['Pending to Bill', fmtCompact(pendBill), fmtPct(pendBill, totVal) + ' of value'],
          ['Pending to ' + oc.fulfilLabel, fmtCompact(pendFul), fmtPct(pendFul, totVal) + ' of value']
