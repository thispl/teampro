    let mgrData = [];

    function fmtCr(v) {
        v = Math.abs(Number(v) || 0);
        if (v >= 1e7) return '₹' + (v / 1e7).toFixed(2) + ' Cr';
        if (v >= 1e5) return '₹' + (v / 1e5).toFixed(1) + ' L';
        if (v >= 1e3) return '₹' + (v / 1e3).toFixed(1) + 'K';
        return '₹' + v.toLocaleString('en-IN', { maximumFractionDigits: 0 });
    }

    function srColor(v) {
        return v >= 100 ? '#059669' : v >= 60 ? '#2563eb' : v >= 30 ? '#d97706' : '#dc2626';
    }

    function load_manager_leaderboard() {
        frappe.call({
            method: "teampro.teampro.page.hr_and_admin.hr_and_admin.get_manager_leaderboard",
            callback: function (r) {
                mgrData = r.message || [];

                const depts = [...new Set(mgrData.map(m => m.department).filter(Boolean))].sort();
