    function renderSimpleCard(
        selector,
        label,
        value,
        color = "#0d6efd",
        icon = "fa fa-chart-bar",
        curr = null,
        subtitle = "",
        wrapper = document
    ) {
        $(wrapper).find(selector).html(`
        <div class="card-top-line" style="background:${color};"></div>

        <div class="card-body" style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;padding:18px 15px;box-sizing:border-box;">

            <div class="card-icon" style="background:${color}20;color:${color};width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
                <i class="${icon}"></i>
            </div>

            <div class="card-title">${label}</div>

            <div class="card-value" style="color:${color};">
                ${value}
            </div>

            ${curr !== null ? `
                <div class="card-sub-title" style="margin-top:4px;">
                    (${formatMoney(curr)})
                </div>
            ` : ""}

            ${subtitle ? `
                <div class="card-sub">
                    ${subtitle}
                </div>
            ` : ""}

        </div>
    `);
    }


    function render_summary_cards(data) {
        const cards = [
            { key: "active", cls: "card-active", title: "ACTIVE", icon: "fa fa-user-o", color: "#16a34a", subtitle: "Currently active" },
            { key: "male", cls: "card-male", title: "MALE", icon: "fa fa-mars", color: "#2563eb", subtitle: "Male employees" },
            { key: "female", cls: "card-female", title: "FEMALE", icon: "fa fa-venus", color: "#db2777", subtitle: "Female employees" },
            { key: "present", cls: "card-present", title: "TODAY PRESENT", icon: "fa fa-calendar-check-o", color: "#0d9488", subtitle: "As of today" },
            { key: "absent", cls: "card-absent", title: "TODAY ABSENT", icon: "fa fa-calendar-times-o", color: "#dc2626", subtitle: "As of today" },

        ];

        let html = cards.map(c => `
        <div class="dashboard-card hr-stat-card ${c.cls}"
             id="hr-card-${c.key}"
             onclick='show_dept_breakdown("${c.key}", "${c.title}")'
             style="cursor:pointer;">
        </div>
    `).join('');

        $('#hr-summary-cards').html(html);

        cards.forEach(c => {
            const stat = data[c.key] || { total: 0 };
            renderSimpleCard(`#hr-card-${c.key}`, c.title, stat.total, c.color, c.icon, null, c.subtitle);
        });

        window._hr_summary_data = data;
    }



