                                    <th>TES (%)</th>
                                    <th>PR</th>
                                    <th>PRS</th>
                                    <th colspan="2">PERFORMANCE INDEX</th>
                                </tr>
                            </thead>
                            <tbody>${tableRows}</tbody>
                        </table>
                    `);
                }

                displayCurrentMonth();
                index = (index + 1) % slides.length;
            }

            renderSlide();

            if (!employee && slides.length > 1) {
                slideInterval = setInterval(renderSlide, 20000);
            }
        });
    }
    fetchTargetData(null, null, null);

