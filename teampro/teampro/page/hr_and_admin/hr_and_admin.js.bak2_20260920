                sel.find('option:not(:first)').remove();
                depts.forEach(dp => sel.append(`<option value="${dp}">${dp}</option>`));

                $('#mgr-sub-label').text(
                    `${mgrData.length} target managers · current fiscal year · click a row to open the Target Manager`
