    function render_mgr_table() {
        const dept = $('#mgr-dept-filter').val();
        const sortKey = $('#mgr-sort').val() || 'mtd_sr';

        let rows = mgrData.filter(m => !dept || m.department === dept);
        rows.sort((a, b) => (b[sortKey] || 0) - (a[sortKey] || 0));

        const html = rows.map((m, i) => {
            const initials = (m.employee_name || '--').split(' ').map(w => w[0]).join('').toUpperCase().slice(0, 2);
            const avatar = m.employee_image
                ? `<img src="${m.employee_image}" class="hra-avatar" />`
                : `<div class="hra-avatar">${initials}</div>`;
            const mtdW = Math.min(m.mtd_sr || 0, 100);
            const ytdW = Math.min(m.ytd_sr || 0, 100);
            return `
                <tr class="hra-clickable" onclick="frappe.set_route('Form','Target Manager','${m.name}')">
                    <td><span class="hra-rank ${i < 3 ? 'r' + (i + 1) : ''}">${i + 1}</span></td>
                    <td>
                        <div class="hra-mgr-cell">
                            ${avatar}
                            <div>
                                <div class="hra-emp-name">${m.employee_name || '-'}</div>
                                <div class="hra-emp-sub">${m.designation || '-'} · ${m.department || '-'}</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        ${m.has_reportees
                            ? `<span class="hra-chip purple">${m.reportee_count} reportees</span>`
                            : '<span class="hra-emp-sub" style="text-align:center;">—</span>'}
                    </td>
                    <td style="font-weight:700;">${fmtCr(m.annual_ct)}</td>
                    <td style="min-width:130px;">
                        <div class="hra-emp-sub" style="margin-bottom:2px;text-align:center;">${fmtCr(m.mtd_achieved)} / ${fmtCr(m.mtd_target)}</div>
                        <div class="hra-bar"><div style="width:${mtdW}%;background:${srColor(m.mtd_sr)};"></div></div>
                        <div style="font-size:11px;font-weight:800;color:${srColor(m.mtd_sr)};">${m.mtd_sr}%</div>
                    </td>
                    <td style="min-width:130px;">
                        <div class="hra-emp-sub" style="margin-bottom:2px;text-align:center;">${fmtCr(m.ytd_achieved)} / ${fmtCr(m.ytd_target)}</div>
                        <div class="hra-bar"><div style="width:${ytdW}%;background:${srColor(m.ytd_sr)};"></div></div>
                        <div style="font-size:11px;font-weight:800;color:${srColor(m.ytd_sr)};">${m.ytd_sr}%</div>
                    </td>
                    <td>
                        <span style="color:${m.ep > 0 ? '#047857' : '#64748b'};font-weight:700;">${m.ep}</span>
                        /
                        <span style="color:${m.nc < 0 ? '#dc2626' : '#64748b'};font-weight:700;">${m.nc}</span>
                    </td>
                    <td style="font-weight:700;color:${srColor(m.sr)};">${m.sr}%</td>
                </tr>
            `;
        }).join('');

        $('#mgr-leaderboard').html(`
            <table class="hra-table">
                <thead><tr>
                    <th>#</th>
                    <th style="text-align:left;">Manager / Employee</th>
                    <th>Team</th>
                    <th>Annual CT</th>
                    <th>MTD Ach / Target · SR%</th>
                    <th>YTD Ach / Target · SR%</th>
                    <th>EP / NC</th>
                    <th>Overall SR%</th>
                </tr></thead>
                <tbody>
                    ${html || '<tr><td colspan="8" style="text-align:center;padding:24px;color:#9ca3af;">No target managers found</td></tr>'}
                </tbody>
            </table>
        `);
    }

    $(wrapper).on('change', '#mgr-dept-filter, #mgr-sort', render_mgr_table);


    // ══════════════════════════════════════════════════════════
    //  V2 — EPNC summary chips
    // ══════════════════════════════════════════════════════════
    function load_epnc_summary() {
        frappe.call({
            method: "teampro.teampro.page.hr_and_admin.hr_and_admin.get_epnc_summary",
            callback: function (r) {
                const d = r.message || {};
                const t = d.totals || {};
                const net = parseFloat(t.net) || 0;
                $('#epnc-summary-chips').html(`
                    <span class="hra-chip green">Total EP <b>+${t.total_ep || 0}</b></span>
                    <span class="hra-chip red">Total NC <b>${t.total_nc || 0}</b></span>
                    <span class="hra-chip ${net >= 0 ? 'green' : 'red'}">Net ENS <b>${net}</b></span>
                    <span class="hra-chip">Entries <b>${(t.ep_entries || 0) + (t.nc_entries || 0)}</b></span>
                    <span class="hra-chip">Employees <b>${t.employees_scored || 0}</b></span>
                    ${(d.top_ep && d.top_ep[0]) ? `<span class="hra-chip green">Top EP: <b>${d.top_ep[0].emp_name}</b> +${d.top_ep[0].score}</span>` : ''}
                    ${(d.top_nc && d.top_nc[0]) ? `<span class="hra-chip red">Max NC: <b>${d.top_nc[0].emp_name}</b> ${d.top_nc[0].score}</span>` : ''}
                `);
            }
        });
    }

    // ── v2 init calls ──
    load_extended_stats();
    ensure_chartjs_loaded(function () {
        load_pr_scoring();
    });
    load_manager_leaderboard();
    load_epnc_summary();

};



