            f.df.options = names.join("\n");
            f.refresh();
            const def = frappe.defaults.get_user_default("Company");
            if (def && names.includes(def)) {
                dialog.set_value("company", def);
            } else if (names.length) {
                dialog.set_value("company", names[0]);
            }
        });
