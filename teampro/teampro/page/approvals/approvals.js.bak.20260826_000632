        function render_rp_table() {
            const html = dialog.get_field("outstanding_html_rp");
            if (!rp_rows.length) {
                html.$wrapper.html('<div style="padding:8px;text-align:center;color:#888;background:#f9fafb;border:1px dashed #d1d5db;border-radius:4px;font-size:12px;">No references. Click "Fetch Outstanding Bills" to load bills, or "Add Row" to add manually.</div>');
